#!/bin/bash
# SPDX-License-Identifier: LGPL-2.1-or-later

set -euo pipefail

SCRIPT_DIR=$(dirname $(realpath ${BASH_SOURCE[0]}))
OPT_REMOTE=
OPT_LINK=
OPT_BRANCH=
OPT_SIGN=
OPT_EDIT=--no-edit
OPT_INTERACTIVE=

usage() {
	echo "
Usage: $(basename $0) [OPTIONS] <PR> [trailers ...]
Fetch a pull-request from github

OPTIONS
    -l          Add link to the PR in the commit message using applypr.link-base from config
    -s		Add Signed-off-by by the current user
    -b <branch>	Create a new branch, checkout and apply patches there.
    -r <remote> Use <remote>, otherwise uses fetchpr.remote from config
    -e		Edit commit message
    -i		Use --iterative for git-rebase when applying
" 1>&$1;
	exit $(($1 - 1));
}

setup_link_base() {
	OPT_LINK=$(git config --get --default="" applypr.link-base)
	if [ -z "$OPT_LINK" ]; then
		echo "Option -l requires applypr.link-base from config" >&2
		usage 2
	fi
	# remove trailing / if it exists
	OPT_LINK="${OPT_LINK%/}"
}

setup_sign() {
	OPT_SIGN="Signed-off-by: $(git config --get user.name) <$(git config --get user.email)>"
}

setup_edit() {
	OPT_EDIT=--edit
}

setup_remote() {
	OPT_REMOTE="$1"
}

setup_branch() {
	OPT_BRANCH="$1"
}

args=0
while getopts "lsb:r:eih" o; do
	case "${o}" in
		l) setup_link_base; args=$[$args + 1];;
		s) setup_sign; args=$[$args + 1];;
		b) setup_branch $OPTARG; args=$[$args + 2];;
		r) setup_remote $OPTARG; args=$[$args + 2];;
		e) setup_edit; args=$[$args + 1];;
		i) OPT_INTERACTIVE=--interactive; args=$[$args + 1];;
		h) usage 1;;
		\?) usage 2;;
	esac
done
shift $args

if [[ -n "$OPT_BRANCH" ]]; then
	branch="$OPT_BRANCH"
else
	branch=$(git rev-parse --abbrev-ref HEAD)
fi

pr=$1
shift

trailers=("$@")
if [[ -n "$OPT_LINK" ]]; then
	trailers+=("Link: $OPT_LINK/pull/$pr")
fi
# now wrap each trailer with "--trailer '$t'"
trailers=("${trailers[@]/#/--trailer \'}")
trailers=("${trailers[@]/%/\'}")

fetchpr_args=()
if [[ -n "$OPT_REMOTE" ]]; then
	fetchpr_args+=("-r" "$OPT_REMOTE")
fi
$SCRIPT_DIR/git-fetchpr "${fetchpr_args[@]}" $pr

if [[ "$branch" != "HEAD" ]]; then
	export GIT_SEQUENCE_EDITOR="$SCRIPT_DIR/__toolbox_git_sequence_editor.sh"
	export TOOLBOX_GIT_SEQUENCER_APPEND="x git checkout -B $branch HEAD"

	if [[ -n "$OPT_INTERACTIVE" ]]; then
		export TOOLBOX_GIT_SEQUENCER_INTERACTIVE=1
	fi

	# we always use interactive to make sure GIT_SEQUENCE_EDITOR is used, which
	# will fire the editor if it was really supposed to be interactive
	OPT_INTERACTIVE=--interactive
fi

# `git -c trailer.* .. commit --amend` doesn't work consistently and doesn't allow to
# give different placements for the trailers. So prefer the alternative as:
# git log --format=%B -1 | git interpret-trailers ... | git commit --amend -F-
trailers_str="git log --format=%B -1 "
trailers_str+="| git interpret-trailers --no-divider --where=end --if-exists=addIfDifferent ${trailers[*]} "
if [[ -n "$OPT_SIGN" ]]; then
	trailers_str+="--if-exists=replace --trailer '$OPT_SIGN' "
fi
trailers_str+="| git commit --amend -F-"

exec_args=(-x "$trailers_str")

git rebase $OPT_INTERACTIVE \
	"${exec_args[@]}" \
	--onto HEAD HEAD FETCH_HEAD
